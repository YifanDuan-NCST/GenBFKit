{
  "database": {
    "host": "localhost",
    "port": 5432,
    "database": "genbfkit",
    "user": "postgres",
    "password": "your_password_here",
    "schema": "public",
    "connection_pool_size": 10,
    "connection_timeout": 30
  },
  "time_alignment": {
    "target_timezone": "UTC",
    "target_frequency": "1s",
    "default_interpolation": "LINEAR",
    "max_gap_seconds": 300,
    "enable_outlier_detection": true,
    "outlier_threshold_sigma": 3.0
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "/app/work/logs/bypass/time_alignment.log",
    "max_bytes": 10485760,
    "backup_count": 5
  }
}
